# Copy to .env (git-ignored). Never commit real credentials.
# This file is only for LOCAL development. The app itself needs no key files: on first run it prints a
# one-time setup code and you create the admin password in the browser.

# Password for the local docker-compose database. Generate one:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=

# Postgres with pgvector (expands POSTGRES_PASSWORD when sourced by a shell or read by compose).
DATABASE_URL=postgresql://pagerlens:${POSTGRES_PASSWORD}@127.0.0.1:5433/pagerlens

# Optional: provider accounts are normally added in the web app (Settings). Uncomment only if you want a
# single provider configured from the environment instead.
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_CHAT_MODEL=
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIM=768

# Optional: allow provider URLs on localhost/private networks (for example a local Ollama).
# PAGERLENS_ALLOW_PRIVATE_LLM_URLS=true

# Set to true ONLY for throwaway local demos: disables authentication entirely.
# PAGERLENS_ALLOW_ANONYMOUS=false
